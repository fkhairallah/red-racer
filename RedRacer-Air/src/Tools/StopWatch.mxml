<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		xmlns:Components="Components.*" 
		xmlns:mx="library://ns.adobe.com/flex/mx"
		title="StopWatch">
	<s:layout>
		<s:VerticalLayout horizontalAlign="center" paddingBottom="15" paddingLeft="2" paddingRight="2"
						  paddingTop="5"/>
	</s:layout>
	
	<fx:Script>
		<![CDATA[
			import spark.core.NavigationUnit;
			protected function btnStart_clickHandler(event:MouseEvent):void
			{
				gVar.timerStartTime = new Date;
				var fin:String = "Start: " + dateFormatter.format(new Date);
				gVar.timerFinishList.addItem(fin);
			}
			
			protected function btnFinish_clickHandler(event:MouseEvent):void
			{
				var finTime:Date = new Date;
				var fin:String = dateFormatter.format(finTime);
				fin += " - (" + int((finTime.time - gVar.timerStartTime.time)/1000) + "s)";
				gVar.timerFinishList.addItem(fin);
				
				// Validate the layout and then scroll to the end
				lstFinish.validateNow();
				lstFinish.layout.verticalScrollPosition += lstFinish.layout.getVerticalScrollPositionDelta(NavigationUnit.END);
				
				// First scroll may have been inaccurate because new reflow item was exposed, scroller layout changed
				lstFinish.validateNow();
				lstFinish.layout.verticalScrollPosition += lstFinish.layout.getVerticalScrollPositionDelta(NavigationUnit.END);

				
			}
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<mx:DateFormatter id="dateFormatter" formatString="HH:NN:SS"/>
	</fx:Declarations>
	
	
	<Components:RealTimeClock width="90%" height="25%" />
	<s:Button id="btnStart" label="Start" click="btnStart_clickHandler(event)" width="80%"/>
	
	<s:Button id="btnFinish" label="Mark" click="btnFinish_clickHandler(event)" width="80%"/>
	<s:Label width="100%" fontSize="18" text="Marked ({lstFinish.dataProvider.length})"
			 textAlign="center"/>
	<s:Rect width="100%" height="2">
		<s:fill>
			<s:SolidColor color="black" />
		</s:fill>
	</s:Rect>
	<s:List id="lstFinish" width="100%" height="100%" dataProvider="{gVar.timerFinishList}">
		<s:itemRenderer>
			<fx:Component>
				<s:ItemRenderer>
					<Components:HContainer width="100%" height="100%">
						<s:Label fontSize="18" text="{data}" verticalAlign="middle" width="100%"/>
					</Components:HContainer>					
				</s:ItemRenderer>
			</fx:Component>
		</s:itemRenderer>
	</s:List>
</s:View>
