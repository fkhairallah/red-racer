<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" 
		xmlns:s="library://ns.adobe.com/flex/spark" 
		title="On Land">
	<s:states>
		<s:State name="portrait"/>
		<s:State name="landscape"/>
	</s:states>
	<s:layout>
		<s:TileLayout horizontalAlign="justify" verticalAlign="middle" columnAlign="justifyUsingWidth"
					  paddingBottom="20" paddingLeft="20" paddingRight="20" paddingTop="20" 
					  requestedColumnCount.portrait="1" requestedColumnCount.landscape="2" />
	</s:layout>
	
	<fx:Script>
		<![CDATA[
			import Marks.CourseMarksList;
			import Marks.WaypointList;
			
		]]>
	</fx:Script>

	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<s:Button label="Waypoints" width="100%" click="{navigator.pushView(WaypointList,{selected:false});}"/>		
	<s:Button label="Marks" width="100%" click="{navigator.pushView(CourseMarksList,{selected:false});}"/>		
	<s:Button label="Vessel Dynamics" width="100%" click="{navigator.pushView(VesselCalibration)}"/>
	<s:Button label="Vessel Polars" width="100%" click="{navigator.pushView(PolarsView)}"/>		
	<s:Button label="Settings" width="100%" click="{navigator.pushView(NewProfileView)}" />
	<s:Button label="Check Device Hardware" width="100%" click="{navigator.pushView(CheckHardware)}"/>		
	<s:Button label="Memorize Performance" width="100%" click="{navigator.pushView(PerformanceShowList)}"/>		

</s:View>
