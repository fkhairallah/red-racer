<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark"
		xmlns:Line="Line.*"
		xmlns:Marks="Marks.*" 
		xmlns:Components="Components.*"
		initialize="initializeHandler(event)"
		creationComplete="creationCompleteHandler(event)"
		add="addHandler(event)"
		destructionPolicy="never"
		title="Mark Editor">
	<s:states>
		<s:State name="portrait"/>
		<s:State name="landscape"/>
	</s:states>
	<s:layout.landscape>
		<s:HorizontalLayout paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
	</s:layout.landscape>
	<s:layout.portrait>
		<s:VerticalLayout  paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" />
	</s:layout.portrait>
	
	<fx:Script>
		<![CDATA[
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			import Chart.WaypointChart;
			
			import Model.Course.CourseMark;
			import Model.Data.GPSPoint;
			
			import Tools.LocatePoint;
			
			import digitalretro.components.MessageBox;
			import digitalretro.events.MessageBoxEvent;
			
			import images.BlackCrosshair;
			import images.Chain;
			import images.Icon_map35;
			
			[Bindable]protected var dPoint:CourseMark;	// current waypoint under edit
			[Bindable]protected var referenceList:ArrayCollection;	// Stores list of all known waypoints & Marks
			
			
			protected function initializeHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
				dPoint = new CourseMark();
				
				// if we're passed a GPS point, load it 
				if (data != null) 
					dPoint.loadFromObject(data as CourseMark);
				

				
			}
			
			protected function creationCompleteHandler(event:FlexEvent):void
			{
				// if waypoint list is empty ==> build it from course points & waypoints
				referenceList = new ArrayCollection;
				referenceList.addItem(gVar.course.rcBoat);
				referenceList.addAll(gVar.waypoints);
				referenceList.addAll(gVar.marks);
			}
			
			
			
			protected function updateMarkDisplay():void
			{
				tiLat.text = dPoint.latString();
				tiLon.text = dPoint.lonString();
				lblReference.text = dPoint.relativeInfo(gVar.distance, gVar.bearing);
			}
			
			// this routine is called when the view is 'add'ed to the display list
			// it is used to handle the call to EditGPSCoordinates which might 
			// update the gps coordinates.
			// if a valid object is returned, then it updates dPoint
			protected function addHandler(event:FlexEvent):void
			{
				// if nothing returned, or the return has no object --> do nothing
				if ( (navigator.poppedViewReturnedObject != null) &&
					(navigator.poppedViewReturnedObject.object != null) )
				{
					dPoint = navigator.poppedViewReturnedObject.object as CourseMark;
					dPoint.isRelative = false;	// no longer relative if we've edited GPS coordinates
				}
				updateMarkDisplay();
				
			}
			
			
			protected function btnSave_clickHandler(event:MouseEvent):void
			{
				dPoint.name = dPoint.name.toUpperCase();
				
				if (data != null) {
					data.loadFromObject(dPoint);
				}
				else 
				{
					gVar.marks.addItem(dPoint);
				}
				
				gVar.marks.refresh(); // refresh sort
				navigator.popView();				
			}
			
			protected function btnCancel_clickHandler(event:MouseEvent):void
			{
				navigator.popView();
			}
			
			
			protected function gps_clickHandler(event:MouseEvent):void
			{
				dPoint.lat = gVar.vData.currentData.lat;
				dPoint.lon = gVar.vData.currentData.lon;
				dPoint.isRelative = false; // not a relative point
				
				updateMarkDisplay();
				
			}
			
			
			
			protected function cbFromPoint_clickHandler(event:MouseEvent):void
			{
				cbFromPoint.openDropDown();
				
				// if already relative to a point ==> set wheel to that point
				if (dPoint.isRelative) {
					for each (var w:GPSPoint in referenceList) {
						if (w.name == dPoint.relativeName) slReferencePoint.selectedItem = w;
					}
					tiRange.text = gVar.distance.getDisplayDistance(dPoint.relativeRange).toFixed(1);
					tiBearing.text = gVar.bearing.getDisplayBearing(dPoint.relativeBearing).toFixed(0);
				} else {
					tiBearing.text = "";
					tiRange.text = "";
				}
				
			}
			
			
			// this routine will set lat/lon of the waypoint based on 
			// distance and bearing from another point
			protected function btnSetPoint_clickHandler(event:MouseEvent):void
			{
				var r:Number;
				var b:Number;
				if (tiRange.text == "") r = 0;
				else r = parseFloat(tiRange.text);
				if (tiBearing.text == "") b = 0;
				else b = parseFloat(tiBearing.text);
				
				var pt:GPSPoint = slReferencePoint.selectedItem as GPSPoint;
				
				
				dPoint.setRelativePoint(pt, gVar.distance.convertFromDisplay(r), gVar.bearing.convertFromDisplay( b ));
				
				
				if (dPoint.isValid){
					tiLat.text = dPoint.latString();
					tiLon.text = dPoint.lonString();
				}
				updateMarkDisplay();
				
				cbFromPoint.closeDropDown();
			}
			
			
			protected function tiLat_clickHandler(event:MouseEvent):void
			{
				if (dPoint.isRelative)
				{
					var msgBox:MessageBox = MessageBox.show(this.parent, 
						MessageBox.MB_YESNO, MessageBox.IC_EDIT, 
						"Edit lat/lon", "This will remove relationship to " + dPoint.relativeName + ". Proceed?");
					
					msgBox.addEventListener(MessageBoxEvent.MESSAGEBOX_YES, msgBox_onYes);
					msgBox.addEventListener(MessageBoxEvent.MESSAGEBOX_NO, msgBox_onNo);
				}
				else
				{
					navigator.pushView(EditGPSCoordinates,dPoint);
				}
			}
			private function msgBox_onYes(event:MessageBoxEvent):void
			{
				var msgBox:MessageBox = event.target as MessageBox;
				msgBox.removeEventListener(MessageBoxEvent.MESSAGEBOX_YES, msgBox_onYes);
				msgBox.removeEventListener(MessageBoxEvent.MESSAGEBOX_NO, msgBox_onNo);
				
				dPoint.isRelative = false;
				navigator.pushView(EditGPSCoordinates,dPoint);
			}
			private function msgBox_onNo(event:MessageBoxEvent):void
			{
				var msgBox:MessageBox = event.target as MessageBox;
				msgBox.removeEventListener(MessageBoxEvent.MESSAGEBOX_YES, msgBox_onYes);
				msgBox.removeEventListener(MessageBoxEvent.MESSAGEBOX_NO, msgBox_onNo);
			}
			
			
			
			
			
		]]>
	</fx:Script>
	<fx:Declarations>
		
	</fx:Declarations>
	
	<s:VGroup horizontalAlign="center"
			  width.portrait="100%" width.landscape="50%"
			  height.portrait="50%" height.landscape="100%">
		<s:HGroup width="100%">
			<s:Label height="100%" text="Name/Letter:" verticalAlign="middle"/>
			<s:TextInput id="tiName" width="100%" autoCapitalize="all" autoCorrect="false" textAlign="center"
						 enter="{tiLat.setFocus();}" text="@{dPoint.name}"
						 width.portrait="100" fontSize.portrait="32"/>			
		</s:HGroup>
		<s:HGroup width="100%">
			<s:Label height="100%" text="Description:" verticalAlign="middle"/>
			<s:TextInput id="tiDescription" width="100%" text="@{dPoint.description}" />			
		</s:HGroup>
		<s:Label id="lblReference" visible="{dPoint.isRelative}" width="100%"
				 text="{dPoint.relativeInfo(gVar.distance, gVar.bearing)}"
				 fontWeight="bold" textAlign="center" />
		<Components:HContainer width="100%"  click="tiLat_clickHandler(event)">
			<s:Label id="tiLat" width="50%" fontSize="20" textAlign="center"/>
			<s:Label id="tiLon" width="50%" fontSize="20" textAlign="center"/>
		</Components:HContainer>
		<s:HGroup>
			<s:Button icon="{images.Icon_map35}" width="42" height="42" visible="{dPoint.isValid}"
					  click="{navigator.pushView(WaypointChart,dPoint)}" />			
			<s:Button label="Find it..." visible="{dPoint.isValid}"
					  click="{navigator.pushView(LocatePoint,dPoint)}" />
		</s:HGroup>
	</s:VGroup>
	
	<s:Rect width="1" height="100%" visible.portrait="false" >
		<s:fill>
			<s:SolidColor color="0xaaaaaa" />
		</s:fill>
	</s:Rect>
	
	<s:VGroup horizontalAlign="center" 
			  width.portrait="100%" width.landscape="50%"
			  height.portrait="50%" height.landscape="100%">
		
		<s:VGroup width="100%" height="100%" horizontalAlign="center">
			<s:Button click="gps_clickHandler(event)" height="64"
					  icon="{images.BlackCrosshair}"
					  label="Set to here"
					  top.landscape="5" horizontalCenter="0"
					  left.portrait="15"/>		
			<s:CalloutButton id="cbFromPoint" height="64" label="Relative to..."
							 click="cbFromPoint_clickHandler(event)" icon="{images.Chain}"
							 bottom.landscape="5" horizontalCenter="0"
							 right.portrait="10">
				<s:calloutContent >							
					<s:HGroup width="100%" height="100%" paddingTop="5" paddingBottom="5" paddingLeft="5" paddingRight="5">
						<s:SpinnerListContainer width="70%" height="100%">
							<s:SpinnerList id="slReferencePoint" width="100%" height="100%" textAlign="center" labelField="name"
										   dataProvider="{referenceList}" selectedIndex="0"/>
						</s:SpinnerListContainer>
						<s:VGroup width="30%" horizontalAlign="center">
							<s:Label text="Range"/>
							<s:TextInput id="tiRange" width="100%" fontSize="24"
										 softKeyboardType="punctuation" returnKeyLabel="next" restrict="0-9."
										 enter="{tiBearing.setFocus();}"/>
							<s:Label text="Bearing"/>
							<s:TextInput id="tiBearing" width="100%" fontSize="24"
										 softKeyboardType="punctuation" returnKeyLabel="go" restrict="0-9."
										 enter="{btnSetPoint.setFocus()}"/>
							<s:Button id="btnSetPoint" label="Set" click="btnSetPoint_clickHandler(event)" horizontalCenter="0" />
						</s:VGroup>
					</s:HGroup>
					
				</s:calloutContent>
			</s:CalloutButton>
		</s:VGroup>
		
		<s:Button id="btnSave" label="Save" click="btnSave_clickHandler(event)" />
	</s:VGroup>
</s:View>
