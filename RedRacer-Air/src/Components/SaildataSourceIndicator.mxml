<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009" 
		  xmlns:s="library://ns.adobe.com/flex/spark"
		  width="32" height="32" xmlns:images="images.*">
	
	<fx:Script>
		<![CDATA[
			import Model.Data.SailPointEvent;

			public function refresh(event:SailPointEvent):void
			{
				if (gVar.vData != null) 
				{
					imgGPS.visible = event.isStandaloneMode;
					imgWIFI.visible = !imgGPS.visible;					
					imgNoConnected.visible = !event.isConnected;		
				}
			}
		]]>
	</fx:Script>
	
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
	</fx:Declarations>
	<images:GPS id="imgGPS" width="100%" height="100%" visible="false" />
	<images:WIFI id="imgWIFI" width="100%" height="100%" visible="false"  />
	<images:BigX id="imgNoConnected" width="100%" height="100%" visible="false" />
</s:Group>
