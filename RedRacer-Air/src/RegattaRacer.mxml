<?xml version="1.0" encoding="utf-8"?>
<s:ViewNavigatorApplication xmlns:fx="http://ns.adobe.com/mxml/2009"
							xmlns:s="library://ns.adobe.com/flex/spark"
							xmlns:Data="Model.Data.*"
							xmlns:Model="Model.*"
							xmlns:Course="Model.Course.*" 
							xmlns:Components="Components.*"
							applicationDPI="160"
							resizeForSoftKeyboard="false"
							firstView="views.HomeView"
							initialize="app_initializeHandler(event)"
							applicationComplete="contentCreationCompleteHandler(event)"
							activate="activateHandler(event)"
							deactivate="onDeactivate(event)"
							splashScreenImage="@Embed('images/SplashScreen.png')"
							splashScreenScaleMode="stretch" 
							>
	<fx:Style source="RegattaRacer.css"/>
	<s:navigationContent>
		<s:Button label="Back" click="{navigator.popView()}" color="black">
			<s:icon>
				<s:MultiDPIBitmapSource source160dpi="@Embed('images/LeftChevron160.png')"
										source240dpi="@Embed('images/LeftChevron240.png')"
										source320dpi="@Embed('images/LeftChevron320.png')"/>
			</s:icon>
		</s:Button>
	</s:navigationContent>
	<s:actionContent>
		<s:Spacer width="5" />
		<s:CalloutButton id="btnMenu" icon="{Icon_Repair}" color="black" height="34">
			<s:calloutContent>
				<s:VGroup width="200" gap="5" paddingBottom="5" paddingLeft="5" paddingRight="5" paddingTop="5" horizontalAlign="center">
					<s:Label text="Tools:" />
					<s:Button label="Set Wind" width="80%" click="{navigator.pushView(WindDirection)}"
							  visible="{gVar.vData.isStandaloneMode}"
							  includeInLayout="{gVar.vData.isStandaloneMode}"/>
					<s:Button label="Instruments" width="80%" click="{navigator.pushView(InstrumentView)}"
							  enabled="{!(navigator.activeView is InstrumentView)}" />
					<s:Button label="Locate Point" width="80%" click="{navigator.pushView(LocatePoint)}"
							  enabled="{!(navigator.activeView is LocatePoint)}"/>
					<s:Button label="Nav Segment" width="80%" click="{navigator.pushView(NavigateSegment)}"
							  enabled="{!(navigator.activeView is NavigateSegment)}" />
					<s:Button label="Stopwatch" width="80%" click="{navigator.pushView(StopWatch)}"
							  enabled="{!(navigator.activeView is StopWatch)}"/>
					<s:Group width="80%">
						<s:Button width="40%" icon="{HelpIcon}" left="0" verticalCenter="0"
								  click="{navigateToURL(new URLRequest('http://www.regattared.com/red-racer-help/'));}" />
						<Components:SaildataSourceIndicator id="dSDSI" width="40%" height="{dSDSI.width}" right="0" verticalCenter="0"/>
					</s:Group>
					
					<s:Button label="DEBUG" width="80%" click="{navigator.pushView(DebugView)}"
							  visible="{debugMode}" includeInLayout="{debugMode}"/>
					
				</s:VGroup>
			</s:calloutContent>
		</s:CalloutButton>
	</s:actionContent>
	
	
	<fx:Script>
		<![CDATA[
			import flash.net.navigateToURL;
			
			import mx.collections.ArrayCollection;
			import mx.events.FlexEvent;
			
			import Land.ImportExport;
			
			import Model.Course.RaceCourse;
			import Model.Data.SailPointEvent;
			
			import Tools.InstrumentView;
			import Tools.LocatePoint;
			import Tools.NavigateSegment;
			import Tools.StopWatch;
			import Tools.WindDirection;
			
			import icons.HelpIcon;
			import icons.Icon_Repair;
			
			import views.DebugView;
			import views.HomeView;
			import views.StartupView;
						
			// the below flag is used to put the all in debug mode. 
			// this should be turned off before release
			[Bindable]public static var debugMode:Boolean = false;
			
			
			protected function app_initializeHandler(event:FlexEvent):void
			{
				// when here  DO NOT allow phone to sleep
				NativeApplication.nativeApplication.systemIdleMode = SystemIdleMode.KEEP_AWAKE;
				
				// capture the exit event
				NativeApplication.nativeApplication.addEventListener(Event.EXITING, handleExitEvent);
				
				NativeApplication.nativeApplication.addEventListener(InvokeEvent.INVOKE, handleInvokeEvent);
				
				// initialize the distriqtANE(s)
				
//				ApplicationRater.init( distriqt_Key );
//				ApplicationRater.service.setDaysUntilPrompt(15);
//				ApplicationRater.service.setSignificantEventsUntilPrompt( 5 );
//				ApplicationRater.service.setApplicationId("892581731", ApplicationRater.IMPLEMENTATION_IOS);
//				ApplicationRater.service.setApplicationId("air.com.deligent.redracer", ApplicationRater.IMPLEMENTATION_ANDROID);
				//ApplicationRater.service.debugMode = true;
				
				// initialize global variable pool
				gVar.loadFromStorage(persistenceManager);	// load data from
				gVar.numberOfRuns++;				// increments the number of runs
				gVar.courseList = acCourseLayout;
				
				// start listening immediately
				gVar.vData.startConnection();
				
				// now hook status display to the connection event
				gVar.vData.addEventListener(SailPointEvent.CONNECTION,dSDSI.refresh);
				
				
				
				// cheat for now & load a whole mess of waypoints.
				if ( debugMode && (gVar.waypoints.length < 2) )
					gVar.waypoints.addAll(acWayPoints);
				
				// now get the app version and compare it to what's stored
				// if they are different ==> show help screen & update stored version
				var descriptor:XML = NativeApplication.nativeApplication.applicationDescriptor;
				var ns:Namespace = descriptor.namespaceDeclarations()[0];
				var dVersion:String = descriptor.ns::versionNumber; // display it at bottom of screen
				if (gVar.appVersion != dVersion) // first run - show help				
				{
					gVar.appVersion = dVersion;
					navigator.pushView(HomeView);
					navigator.pushView(StartupView);
				}
				
			}
			
			/**************************************************************************************
			 * 
			 * Once the app is completely created, set device orientation
			 * 
			 * Then -- see if we have an openUrl invole event (e.g. started with a file) and act on it
			 * why? because if we act immediatly a view gets loaded before the rest of the app is inited
			 * and it will lock up.
			 * 
			 * ************************************************************************************/
			protected var myInvokeEvent:InvokeEvent;
			protected var isInitialized:Boolean;
			protected function contentCreationCompleteHandler(event:FlexEvent):void
			{
				stage.setAspectRatio( gVar.deviceOrientation );
		
				// if we have an openUrl invoke event act on it.
				if(myInvokeEvent != null)navigator.pushView(ImportExport, myInvokeEvent);
				
				isInitialized = true;
			}
			
			protected function handleInvokeEvent(event:InvokeEvent):void
			{
				if (event.reason == "openUrl") 
					if (isInitialized) // if app is initialized --> handle it now.
						navigator.pushView(ImportExport, event);
					else // handle it later
						myInvokeEvent = event;
			}
			
			protected function handleExitEvent(event:Event):void
			{
				gVar.vData.removeEventListener(SailPointEvent.CONNECTION,dSDSI.refresh);
			}
			
			protected function activateHandler(event:Event):void
			{
				gVar.vData.startConnection();
			}
			
			protected function onDeactivate(event:Event):void
			{
				gVar.saveToStorage(persistenceManager);
				gVar.vData.stopConnection();
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
