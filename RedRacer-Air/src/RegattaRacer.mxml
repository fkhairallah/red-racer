								 description="Traditional windward/leeward race with 2 marks."/> 
			<Course:CourseLayout source="images/courses/Olympic.jpg" 
								 text="Olympic/Reaching Leg" courseType="{RaceCourse.CT_TRIANGLE}"
								 description="Triangular course with a reaching leg. Used in Olympics or team racing."/> 
